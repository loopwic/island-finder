{
  "name": "island-finder",
  "private": true,
  "version": "0.1.2",
  "description": "Cross-platform local-first Animal Crossing island selection automation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopwic/island-finder.git"
  },
  "bugs": {
    "url": "https://github.com/loopwic/island-finder/issues"
  },
  "homepage": "https://github.com/loopwic/island-finder#readme",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "npm ci && npm run vision:sync",
    "dev": "npm run dev --workspace @island-finder/desktop",
    "stop": "node scripts/stop-runtime.mjs",
    "dev:web": "turbo run dev --filter @island-finder/web",
    "runtime:start": "uv run --frozen python vision_service/runtime_supervisor.py",
    "start": "npm run start --workspace @island-finder/desktop",
    "start:headless": "uv run --frozen python vision_service/runtime_supervisor.py --autostart",
    "desktop:build": "npm run bundle --workspace @island-finder/desktop",
    "desktop:check": "npm run check --workspace @island-finder/desktop",
    "desktop:fmt": "npm run fmt:check --workspace @island-finder/desktop",
    "desktop:lint": "npm run lint --workspace @island-finder/desktop",
    "typecheck": "turbo run typecheck --filter @island-finder/web",
    "build": "turbo run build --filter @island-finder/web",
    "preview:web": "npm run preview --workspace @island-finder/web",
    "test": "turbo run test",
    "check": "node scripts/check.mjs",
    "controller:start": "npm run start --workspace @island-finder/controller",
    "controller:diagnose": "npm run diagnose --workspace @island-finder/controller",
    "controller:self-test": "npm run self-test --workspace @island-finder/controller",
    "vision:sync": "uv sync",
    "vision:start": "npm run start --workspace @island-finder/vision",
    "vision:test": "npm run test --workspace @island-finder/vision",
    "vision:analyze": "npm run analyze --workspace @island-finder/vision",
    "vision:reanalyze-audits": "npm run reanalyze-audits --workspace @island-finder/vision"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
