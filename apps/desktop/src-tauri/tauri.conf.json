{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Island Finder",
  "version": "0.1.1",
  "identifier": "dev.islandfinder.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev:web",
      "cwd": "../../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../.."
    },
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Island Finder",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": ""
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
